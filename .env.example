# Número de WhatsApp de destino, formato internacional sin "+" ni espacios
# (ej. 5491122334455).
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# URL base del sitio en producción, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos Postgres (ej. Neon). DATABASE_URL es la conexión pooled
# (runtime), DIRECT_URL es la conexión directa sin pooler (usada por el CLI
# de Prisma para db push/migrate).
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host.region.aws.neon.tech/db?sslmode=require"

# Panel /admin. Generar con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 10))"
# Los "$" del hash deben escaparse como "\$" en este archivo (ver README.md).
ADMIN_PASSWORD_HASH="cambiar-este-hash"

# Clave para firmar la cookie de sesión del admin. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-este-secreto"

# Storage de imágenes/videos (Cloudinary). Sacar cloud name/API key/secret
# del dashboard de https://cloudinary.com. También hace falta crear dos
# upload presets "unsigned" en Settings → Upload → Upload presets:
# "gdv_admin_unsigned" (folder: productos/uploads) y
# "gdv_categorias_unsigned" (folder: guias/uploads) — así el admin sube
# fotos directo del navegador a Cloudinary, sin pasar por el server (mucho
# más rápido, sobre todo en mobile).
CLOUDINARY_CLOUD_NAME="cambiar"
CLOUDINARY_API_KEY="cambiar"
CLOUDINARY_API_SECRET="cambiar"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="cambiar"
